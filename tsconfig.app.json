{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": ["tests/**", "src/**/__tests__/*", "mock/**"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // 业务代码只暴露浏览器类型，避免 Node 全局（process、Buffer、__dirname）意外可用
    "types": [],

    "noUncheckedIndexedAccess": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
